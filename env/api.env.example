# Modelo do .env da API (minhasContas-DB). O `./dev setup` cria o .env da API a partir deste arquivo,
# gerando os segredos (marcados com __ __). Nunca coloque valores reais aqui: este arquivo vai para o git.
#
# Banco local: o docker-compose da API sobe o Postgres na porta 5433 com estas credenciais.
POSTGRES_DB=minhascontas
POSTGRES_PASSWORD=__DB_PASSWORD__
DATASOURCE_URL=jdbc:postgresql://localhost:5433/minhascontas
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=__DB_PASSWORD__

# Segredo do JWT (mínimo 32 bytes e pelo menos 10 caracteres distintos)
JWT_SECRET=__JWT_SECRET__

# Primeiro Admin, criado na subida só se ainda não existir nenhum. O login do Admin local é ADMIN_USER + ADMIN_PASSWORD
ADMIN_USER=admin
ADMIN_EMAIL=admin@minhascontas.local
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# Só se um front chamar a API direto pelo navegador (o Web usa o proxy /api e não precisa):
# CORS_ALLOWED_ORIGINS=http://localhost:3000
