  WEB_DIR=$WEB_DIR
  API_PORT=$API_PORT  WEB_PORT=$WEB_PORT
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    reset-db) cmd_reset_db "$@" ;;
    test) cmd_test "$@" ;;
    lint) cmd_lint "$@" ;;
    build) cmd_build "$@" ;;
    git) cmd_git "$@" ;;
    help | -h | --help) cmd_help ;;
    *) err "comando desconhecido: $cmd"; echo >&2; cmd_help >&2; exit 1 ;;
  esac
}

main "$@"
